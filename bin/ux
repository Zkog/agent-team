#!/usr/bin/env bash
# UX (Codex, gpt-5.6-sol). Draws the icons the board asks for.
# Runs on Codex for its built-in image_gen tool — a different Codex model than the
# Reviewer's, and started with a prompt that says which of the two Codex roles it has.
#
# Same sandbox note as the reviewer: workspace-write blocks the network, which silently
# breaks git fetch, gh and therefore the board. Override with AGENT_TEAM_CODEX_FLAGS.
: "${AGENT_TEAM_UX_MODEL:=gpt-5.6-sol}"
: "${AGENT_TEAM_CODEX_FLAGS:=--sandbox danger-full-access --ask-for-approval on-request}"
# shellcheck disable=SC2086
exec "$(dirname "$0")/_start" ux ux.md \
  codex --model "$AGENT_TEAM_UX_MODEL" $AGENT_TEAM_CODEX_FLAGS "You are the UX designer, not the Reviewer. Read AGENTS.md, then your role file at ROLEFILE, and follow its \"On start\" section." "$@"
