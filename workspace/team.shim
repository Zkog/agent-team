#!/usr/bin/env bash
# agent-team workspace launcher — the logic lives in the pinned team submodule and upgrades with it.
export AGENT_TEAM_WS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for primary in po coder; do
  launcher="$AGENT_TEAM_WS/$primary/.claude/skills/agent-team/workspace/team"
  [ ! -f "$launcher" ] || exec "$launcher" "$@"
done
echo "no team installation found in po/ or coder/" >&2
exit 1
